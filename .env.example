DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set a temporary one-time token before visiting /setup-admin; remove it after creating the first admin.
ADMIN_BOOTSTRAP_TOKEN=

# Optional CLI seed fallback for an initial admin account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Google PageSpeed Insights API key (keep server-side; never commit a real key)
PAGESPEED_API_KEY=

# Optional: authenticated, read-only AI Copilot. Set only in the deployment's server environment.
# Use an API key from the approved OpenAI Platform project; never expose it to browser code or commit a real key.
OPENAI_API_KEY=
# Set this to a model available to the approved API project; no default model is assumed.
OPENAI_MODEL=

# Google Drive OAuth integration (server-side only; never commit real values).
# Register this exact callback URL in the Google OAuth Web Client:
# https://YOUR-DEPLOYMENT-DOMAIN/api/integrations/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# Generate with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
